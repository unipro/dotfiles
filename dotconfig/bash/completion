# ~/.config/bash/completion: sourced by ~/.config/bash/init
#
# Loader for the completion snippets dropped into
# ~/.config/bash/completion.d -- the loader is `completion', the drop-ins
# live in `completion.d' beside it, so the whole bash configuration stays
# under ~/.config/bash.
#
# The skip list is spelled out rather than borrowed from bash-completion's
# $_backup_glob and $_blacklist_glob. init loads bash-completion before this
# file, so those are usually defined by now, but relying on them would tie
# this loader to bash-completion being installed at all -- and the @(...)
# pattern they are meant to be used with is an extglob, which macOS's system
# bash 3.2 rejects at parse time when extglob is off.
#
# $BASH_COMPLETION_USER_DIR is deliberately not consulted either: that
# variable is bash-completion's, and it points at a directory with a
# different layout (snippets under a completions/ subdirectory, loaded on
# demand rather than all at once).

comp_dir="$HOME/.config/bash/completion.d"
if [ -d "$comp_dir" ] && [ -r "$comp_dir" ] && [ -x "$comp_dir" ]; then
    for i in "$comp_dir"/*; do
        case "${i##*/}" in
            # Editor and packaging leftovers, plus the Makefile that ships
            # in some completion directories.
            *'~' | *.bak | *.orig | *.rej | *.swp | '#'*'#' | \
            *.dpkg-old | *.dpkg-dist | *.dpkg-new | *.dpkg-tmp | \
            *.rpmorig | *.rpmnew | *.rpmsave | Makefile*)
                continue
                ;;
        esac
        # An unmatched glob leaves the pattern itself in $i; -f filters it.
        if [ -f "$i" ] && [ -r "$i" ]; then
            # shellcheck source=/dev/null
            . "$i"
        fi
    done
fi
unset comp_dir i

# Local Variables:
# mode: shell-script
# End:
