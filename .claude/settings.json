{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(shellcheck:*)",
      "Bash(bash -n:*)",
      "Bash(/bin/bash -n:*)",
      "Bash(/bin/sh -n:*)",
      "Bash(/opt/homebrew/bin/bash -n:*)",
      "Bash(./install.sh --list)",
      "Bash(./install.sh -l)"
    ]
  }
}
